{
  "schemaVersion": 1,
  "id": "cde",
  "version": "${version}",
  "name": "Cobblemon Dungeon Engine",
  "description": "Procedural generation, group logic, world systems, and real-time battle engine for Cobblemon Dungeons.",
  "authors": [
    "Drachi"
  ],
  "contact": {
  },
  "license": "CC0-1.0",
  "icon": "assets/cde/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "net.drachi.cde.CDE"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "net.drachi.cde.CDEClient"
      }
    ],
    "fabric-datagen": [
      {
        "adapter": "kotlin",
        "value": "net.drachi.cde.dungeonsengine.datagen.ModDataGenerator"
      }
    ]
  },
  "mixins": [
    "cde.battleengine.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-language-kotlin": ">=1.13.0+kotlin.2.1.0"
  }
}
